<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nc_think_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/nc_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:top="10dp"
        android:bottom="10dp"
        android:left="1dp"
        android:gravity="left">
        <shape android:shape="rectangle">
            <solid android:color="@color/nc_green" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
