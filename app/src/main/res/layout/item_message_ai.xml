<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="28dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Avatar da IA -->
    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_avatar">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo"
            android:tint="@color/nc_green_bright" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="10dp"
        android:orientation="vertical">

        <!-- Caixa de raciocinio -->
        <LinearLayout
            android:id="@+id/thinkBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_think"
            android:orientation="vertical"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/thinkHeaderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="12dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp">

                <ImageView
                    android:id="@+id/ivThinkIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_think" />

                <TextView
                    android:id="@+id/tvThinkHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="7dp"
                    android:text="@string/reasoning"
                    android:textColor="@color/nc_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <ImageView
                    android:id="@+id/ivChevron"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvThink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingBottom="12dp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/nc_text_dim"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:visibility="gone"
                android:textIsSelectable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMarkdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="560dp"
            android:background="@drawable/bg_bubble_ai"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:textColor="@color/nc_text"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true" />
    </LinearLayout>
</LinearLayout>
